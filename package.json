    "lucide-react": "^0.546.0",
    "mongoose": "^9.10.2",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.10",
    "p-limit": "^7.3.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
